GITHUB_TOKEN=your_token_here
GITHUB_USERNAME=your_github_username

# Public URL of this API, used to build absolute image URLs.
# Set this in production (behind a proxy the API may otherwise build http:// URLs).
PUBLIC_BASE_URL=https://octo-pinned-api.onrender.com

# Optional: comma-separated list of origins allowed to call the API (defaults to *)
# ALLOWED_ORIGINS=https://your-portfolio.example,http://127.0.0.1:5500
